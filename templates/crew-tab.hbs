<section class="tab {{tabs.crew.cssClass}}" data-tab="crew" data-group="primary">
    <div class="eh-crew">
        {{#with crew}}

            {{!-- EDGE --}}
            <fieldset class="eh-card eh-edge-card">
                <legend><i class="fa-solid fa-bolt"></i> Edge</legend>
                <div class="eh-edge-row">
                    <div class="eh-edge-pips">
                        {{#each edgePips}}
                            <a class="eh-edge-pip {{#if filled}}filled{{/if}}" {{#if @root.editable}}data-action="ehToggleEdge"{{/if}} data-value="{{value}}"
                                data-tooltip="{{#if filled}}{{localize "EDGEHEART.Crew.Spend"}}{{else}}{{localize "EDGEHEART.Crew.Gain"}}{{/if}} Edge"><i class="fa-solid fa-bolt"></i></a>
                        {{/each}}
                    </div>
                    <span class="eh-edge-count">{{edge}} / 3</span>
                </div>
                <details class="eh-help">
                    <summary><i class="fa-solid fa-circle-plus"></i> {{localize "EDGEHEART.Crew.EdgeGainsSummary"}}</summary>
                    <ul>{{#each gains}}<li>{{this}}</li>{{/each}}</ul>
                </details>
            </fieldset>

            {{!-- MOVIMENTOS DE EDGE --}}
            <fieldset class="eh-card">
                <legend><i class="fa-solid fa-people-group"></i> {{localize "EDGEHEART.Crew.EdgeMoves"}} <span class="eh-count" data-tooltip="{{localize "EDGEHEART.Crew.CrewAgreesTooltip"}}">{{localize "EDGEHEART.Crew.CrewAgrees"}}</span></legend>
                <ul class="eh-moves">
                    {{#each moves}}
                        <li class="{{#unless affordable}}unaffordable{{/unless}}">
                            <div class="eh-move-head">
                                <i class="fa-solid {{icon}}"></i>
                                <strong>{{name}}</strong>
                                <span class="eh-edge-cost">{{cost}} Edge</span>
                                {{#if @root.editable}}
                                    <button type="button" data-action="ehUseMove" data-move="{{id}}" {{#unless affordable}}disabled{{/unless}}>
                                        {{#if cost}}{{localize "EDGEHEART.Crew.Spend"}}{{else}}{{localize "EDGEHEART.Crew.Announce"}}{{/if}}
                                    </button>
                                {{/if}}
                            </div>
                            <p>{{{text}}}</p>
                            {{#if options}}
                                <ul class="eh-move-options">
                                    {{#each options}}<li><strong>{{name}}:</strong> {{text}}</li>{{/each}}
                                </ul>
                            {{/if}}
                        </li>
                    {{/each}}
                </ul>
            </fieldset>

            {{!-- IDENTIDADE --}}
            <fieldset class="eh-card">
                <legend><i class="fa-solid fa-id-card"></i> Crew <span class="eh-count" data-tooltip="{{localize "EDGEHEART.Crew.TierTooltip"}}">Tier {{tier}}</span></legend>
                <div class="eh-crew-fields">
                    <label data-tooltip="{{localize "EDGEHEART.Crew.ReputationTooltip"}}">
                        <span>{{localize "EDGEHEART.Crew.Reputation"}} <em>+{{reputationValue}}</em></span>
                        <input type="text" name="flags.edgeheart-cyberpunk.crew.reputation" value="{{reputation}}" placeholder="Never Leave Anyone Behind" {{#unless @root.editable}}disabled{{/unless}}>
                    </label>
                    <label data-tooltip="{{localize "EDGEHEART.Crew.CodeTooltip"}}">
                        <span>{{localize "EDGEHEART.Crew.Code"}}</span>
                        <input type="text" name="flags.edgeheart-cyberpunk.crew.code" value="{{code}}" {{#unless @root.editable}}disabled{{/unless}}>
                    </label>
                    <label data-tooltip="{{localize "EDGEHEART.Crew.FixerTooltip"}}">
                        <span>{{localize "EDGEHEART.Crew.Fixer"}}</span>
                        <input type="text" name="flags.edgeheart-cyberpunk.crew.fixer" value="{{fixer}}" {{#unless @root.editable}}disabled{{/unless}}>
                    </label>
                    <label data-tooltip="{{localize "EDGEHEART.Crew.BaseTooltip"}}">
                        <span>{{localize "EDGEHEART.Crew.Base"}}</span>
                        <input type="text" name="flags.edgeheart-cyberpunk.crew.base" value="{{base}}" {{#unless @root.editable}}disabled{{/unless}}>
                    </label>
                </div>
            </fieldset>

            <details class="eh-help">
                <summary><i class="fa-solid fa-circle-question"></i> {{localize "EDGEHEART.Chrome.HowItWorks"}}</summary>
                <ul>
                    <li>{{{localize "EDGEHEART.Crew.Help.Members"}}}</li>
                    <li>{{{localize "EDGEHEART.Crew.Help.Reputation"}}}</li>
                    <li>{{{localize "EDGEHEART.Crew.Help.Assets"}}}</li>
                    <li>{{{localize "EDGEHEART.Crew.Help.NewCharacter"}}}</li>
                    <li>{{{localize "EDGEHEART.Crew.Help.Buttons"}}}</li>
                    <li>{{{localize "EDGEHEART.Crew.Help.AllIn"}}}</li>
                </ul>
            </details>
        {{/with}}
    </div>
</section>
