{
  "id": "edgeheart-cyberpunk",
  "title": "Edgeheart - Cyberpunk Homebrew",
  "description": "A cyberpunk setting for Daggerheart. / Um cenário cyberpunk para Daggerheart.",
  "version": "1.38.0",
  "url": "https://github.com/leomunhoz/Daggerheart_Cyberpunk",
  "manifest": "https://github.com/leomunhoz/Daggerheart_Cyberpunk/releases/latest/download/module.json",
  "download": "https://github.com/leomunhoz/Daggerheart_Cyberpunk/releases/latest/download/module.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14.368"
  },
  "authors": [
    { "name": "Leo Munhoz", "url": "https://github.com/leomunhoz" }
  ],
  "relationships": {
