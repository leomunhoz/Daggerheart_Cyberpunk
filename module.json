    { "name": "edgeheart-domains", "label": "Edgeheart: Competency Cards", "path": "packs/edgeheart-domains", "type": "Item", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "edgeheart-armors", "label": "Edgeheart: Armor", "path": "packs/edgeheart-armors", "type": "Item", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "edgeheart-weapons", "label": "Edgeheart: Weapons", "path": "packs/edgeheart-weapons", "type": "Item", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "edgeheart-cyberware", "label": "Edgeheart: Cyberware", "path": "packs/edgeheart-cyberware", "type": "Item", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "edgeheart-consumables", "label": "Edgeheart: Consumables", "path": "packs/edgeheart-consumables", "type": "Item", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "edgeheart-loot", "label": "Edgeheart: Loot", "path": "packs/edgeheart-loot", "type": "Item", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "edgeheart-adversaries", "label": "Edgeheart: Adversaries", "path": "packs/edgeheart-adversaries", "type": "Actor", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "edgeheart-environments", "label": "Edgeheart: Environments", "path": "packs/edgeheart-environments", "type": "Actor", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
