      "name": "Edgeheart SRD", "sorting": "m", "color": "#00e5ff",
      "packs": ["edgeheart-adversaries", "edgeheart-environments", "edgeheart-journals", "edgeheart-rolltables"],
      "folders": [
        { "name": "Character Options", "sorting": "m", "color": "#000000", "packs": ["edgeheart-lifepaths", "edgeheart-affiliations", "edgeheart-classes", "edgeheart-subclasses", "edgeheart-domains"] },
