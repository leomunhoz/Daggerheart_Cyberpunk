    ]
  },
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "pt-BR", "name": "Português (Brasil)", "path": "lang/pt-BR.json" }
  ],
  "packs": [
    { "name": "edgeheart-lifepaths", "label": "Edgeheart: Life Paths", "path": "packs/edgeheart-lifepaths", "type": "Item", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "edgeheart-affiliations", "label": "Edgeheart: Affiliations", "path": "packs/edgeheart-affiliations", "type": "Item", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "edgeheart-classes", "label": "Edgeheart: Classes", "path": "packs/edgeheart-classes", "type": "Item", "system": "daggerheart", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
